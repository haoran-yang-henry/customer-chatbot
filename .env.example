# Copy to .env for local development. Never commit .env.
CA_APP_ENV=local
CA_LOG_LEVEL=INFO
# console (readable) or json (one object per line, for log collectors)
CA_LOG_FORMAT=console
# Traces to an OTLP/HTTP receiver, e.g. http://localhost:4318 (make up-observability); empty = off
CA_OTEL_ENDPOINT=
# Langfuse: chat turns and model calls as traces, `make eval LANGFUSE=1` as experiments.
# Empty = off. Never on with CA_APP_ENV=test or ci, and never a CI secret.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
CA_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/customer_agent
# Print every SQL statement (debugging only)
CA_SQL_ECHO=false
CA_KNOWLEDGE_DIR=data/knowledge
CA_TENANT_ID=nordelektro

# Embeddings (ADR-0007)
CA_OPENAI_API_KEY=
# Optional: only set for a proxy or compatible endpoint; leave empty for api.openai.com
CA_OPENAI_BASE_URL=
CA_EMBEDDING_MODEL=text-embedding-3-small
CA_EMBEDDING_DIMENSIONS=1536

# Chat model for answer generation (ADR-0008) — any OpenAI-compatible endpoint
CA_LLM_API_KEY=
CA_LLM_BASE_URL=https://opencode.ai/zen/go/v1
CA_LLM_MODEL=deepseek-v4.1-flash
# Without this, deepseek-v4-flash sometimes spends the whole token budget on hidden reasoning
# and returns empty output (measured on Day 4: 2 of 5 router calls). See ADR-0008.
CA_LLM_REASONING_EFFORT=none
# Optional per-role overrides; empty = CA_LLM_MODEL / CA_LLM_REASONING_EFFORT
CA_ROUTER_LLM_MODEL=
CA_ROUTER_REASONING_EFFORT=
CA_ANSWER_LLM_MODEL=
CA_ANSWER_REASONING_EFFORT=
# Resilience (Day 7): router/classifier timeout, SDK retries, circuit breaker per endpoint
CA_ROUTER_TIMEOUT_SECONDS=4
CA_LLM_MAX_RETRIES=1
CA_BREAKER_FAILURE_THRESHOLD=3
CA_BREAKER_RESET_SECONDS=30
# Chat messages per minute per customer or client address; 0 = off
CA_RATE_LIMIT_PER_MINUTE=20
# Share of sessions asked once whether the conversation helped, from this many rounds on
CA_FEEDBACK_SAMPLE_RATE=0.3
CA_FEEDBACK_MIN_ROUNDS=3
# Conversations without a turn for this many days are deleted by `make retention` (run daily)
CA_RETENTION_DAYS=90
# Cache LLM responses on disk for evaluation runs (identical prompt → no new call)
CA_LLM_CACHE_DIR=
# OpenCode Go requires a per-conversation session header and a real User-Agent (ADR-0008)
CA_LLM_SESSION_HEADER=x-opencode-session
CA_LLM_USER_AGENT=nordelektro-customer-agent/0.1.0
# For OpenAI GPT-5 models instead: CA_LLM_BASE_URL= CA_LLM_MODEL=gpt-5.2 CA_LLM_REASONING_EFFORT=none

# Authentication (ADR-0010). Leave CA_AUTH_ISSUER empty to run without authentication.
CA_AUTH_ISSUER=http://localhost:8080/realms/nordelektro
CA_AUTH_AUDIENCE=customer-agent-api

# Browser demo (make demo-public): fixed password for the demo users; unset = a new random one
# per start. Not a CA_ setting: only infra/demo/public.sh reads it.
DEMO_PASSWORD=
