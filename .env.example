# Copy to .env for local development. Never commit .env.
CA_APP_ENV=local
CA_LOG_LEVEL=INFO
CA_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/customer_agent
# Print every SQL statement (debugging only)
CA_SQL_ECHO=false
CA_KNOWLEDGE_DIR=data/knowledge
CA_TENANT_ID=nordelektro

# Embeddings (ADR-0007)
CA_OPENAI_API_KEY=
# Optional: only set for a proxy or compatible endpoint; leave empty for api.openai.com
CA_OPENAI_BASE_URL=
CA_EMBEDDING_MODEL=text-embedding-3-small
CA_EMBEDDING_DIMENSIONS=1536

# Chat model for answer generation (ADR-0008) — any OpenAI-compatible endpoint
CA_LLM_API_KEY=
CA_LLM_BASE_URL=https://opencode.ai/zen/go/v1
CA_LLM_MODEL=deepseek-v4-flash
# Cache LLM responses on disk for evaluation runs (identical prompt → no new call)
CA_LLM_CACHE_DIR=
# OpenCode Go requires a per-conversation session header and a real User-Agent (ADR-0008)
CA_LLM_SESSION_HEADER=x-opencode-session
CA_LLM_USER_AGENT=nordelektro-customer-agent/0.1.0
# For OpenAI GPT-5 models instead: CA_LLM_BASE_URL= CA_LLM_MODEL=gpt-5.2 CA_LLM_REASONING_EFFORT=none
