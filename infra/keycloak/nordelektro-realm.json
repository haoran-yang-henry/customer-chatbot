{
  "realm": "nordelektro",
  "enabled": true,
  "displayName": "NordElektro (development)",
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"validations\": {\"length\": {\"min\": 3, \"max\": 255}}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"validations\": {\"email\": {}}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}], \"unmanagedAttributePolicy\": \"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "customer-chat",
      "name": "NordElektro customer chat (development)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://haoran-yang-henry.github.io/customer-chatbot/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://haoran-yang-henry.github.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "customer_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "audience customer-agent-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "customer-agent-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna.schneider",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Anna",
      "lastName": "Schneider",
      "email": "anna.schneider@example.de",
      "attributes": {
        "customer_id": [
          "C-1001"
        ],
        "tenant_id": [
          "nordelektro"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "nordelektro-dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "jonas.weber",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Jonas",
      "lastName": "Weber",
      "email": "jonas.weber@example.de",
      "attributes": {
        "customer_id": [
          "C-1002"
        ],
        "tenant_id": [
          "nordelektro"
        ]
      },
      "credentials": [
