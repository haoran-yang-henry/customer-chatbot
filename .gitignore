__pycache__/
*.py[cod]
.venv/
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
# evaluation runs: only end-of-day snapshots (dayN.json) are committed
eval/results/*.json
!eval/results/day*.json
# make eval writes this on every run; copy it to groundedness-dayN.jsonl at the end of a day
eval/calibration/*-latest.jsonl
# LLM response cache for evaluation runs
.cache/
# Project documentation is kept locally, not under version control
docs/
# Terraform (infra/gcp): the state holds generated passwords; the lock file is committed
.terraform/
*.tfstate
*.tfstate.*
